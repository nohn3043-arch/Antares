{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gfsip:schema:1.0",
  "title": "GFSIP/1.0 Logical Message",
  "type": "object",
  "required": [
    "type",
    "header"
  ],
  "properties": {
    "type": {
      "enum": [
        "CLIENT_HELLO",
        "SERVER_HELLO",
        "AUTH",
        "AUTH_RESULT",
        "SESSION_READY",
        "RESUME",
        "RESUME_RESULT",
        "OPEN_CHANNEL",
        "CHANNEL_READY",
        "CLOSE_CHANNEL",
        "DATA",
        "APP_ACK",
        "EVENT",
        "PING",
        "PONG",
        "CAPABILITY_UPDATE",
        "GOAWAY",
        "ERROR",
        "DOMAIN_DESCRIPTOR",
        "ROUTE_QUERY",
        "ROUTE_RESULT",
        "STATE_SYNC"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "channel_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACK_REQUIRED",
          "AUDIT_PRESENT",
          "END_CHANNEL",
          "IDEMPOTENT",
          "COMPRESSED",
          "EARLY_DATA"
        ]
      }
    },
    "header": {
      "type": "object"
    },
    "payload_base64": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
