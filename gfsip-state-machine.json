{
  "protocol": "GFSIP/1.0",
  "initial_state": "NEW",
  "terminal_states": [
    "CLOSED"
  ],
  "states": [
    "NEW",
    "NEGOTIATING",
    "AUTHENTICATING",
    "ESTABLISHED",
    "DEGRADED",
    "RESUMING",
    "DRAINING",
    "CLOSED"
  ],
  "invariants": [
    "DATA, EVENT and ROUTE_QUERY are forbidden before ESTABLISHED",
    "GOAWAY forbids new channels",
    "CLOSED accepts no protocol input",
    "Sequence is monotonic per sender direction",
    "Resume never elevates authorization"
  ],
  "transitions": [
    {
      "from": "NEW",
      "event": "CLIENT_HELLO",
      "guard": "valid_format",
      "action": "select_version_and_capabilities",
      "to": "NEGOTIATING"
    },
    {
      "from": "NEGOTIATING",
      "event": "NO_COMMON_VERSION",
      "guard": "true",
      "action": "send_VERSION_UNSUPPORTED",
      "to": "CLOSED"
    },
    {
      "from": "NEGOTIATING",
      "event": "SERVER_HELLO",
      "guard": "version_selected",
      "action": "begin_mutual_authentication",
      "to": "AUTHENTICATING"
    },
    {
      "from": "AUTHENTICATING",
      "event": "AUTH_SUCCESS",
      "guard": "mutual_authorization_passed",
      "action": "send_SESSION_READY",
      "to": "ESTABLISHED"
    },
    {
      "from": "AUTHENTICATING",
      "event": "AUTH_FAILURE",
      "guard": "true",
      "action": "send_AUTH_FAILED",
      "to": "CLOSED"
    },
    {
      "from": "ESTABLISHED",
      "event": "TRANSPORT_LOSS",
      "guard": "resume_context_available",
      "action": "persist_session_state",
      "to": "DEGRADED"
    },
    {
      "from": "DEGRADED",
      "event": "RESUME",
      "guard": "token_valid",
      "action": "reconcile_sequence_and_channels",
      "to": "RESUMING"
    },
    {
      "from": "RESUMING",
      "event": "RESUME_SUCCESS",
      "guard": "state_consistent",
      "action": "rotate_resume_token",
      "to": "ESTABLISHED"
    },
    {
      "from": "RESUMING",
      "event": "RESUME_PARTIAL",
      "guard": "partial_recovery_safe",
      "action": "close_conflicting_channels",
      "to": "ESTABLISHED"
    },
    {
      "from": "RESUMING",
      "event": "RESUME_FAILURE",
      "guard": "state_unrecoverable",
      "action": "send_new_session_required",
      "to": "CLOSED"
    },
    {
      "from": "ESTABLISHED",
      "event": "GOAWAY",
      "guard": "true",
      "action": "reject_new_channels",
      "to": "DRAINING"
    },
    {
      "from": "DRAINING",
      "event": "ALL_CHANNELS_CLOSED",
      "guard": "true",
      "action": "release_session",
      "to": "CLOSED"
    },
    {
      "from": "*",
      "event": "FATAL_ERROR",
      "guard": "state != CLOSED",
      "action": "send_error_and_close",
      "to": "CLOSED"
    }
  ]
}
